; Blotworx Engine 3DS - PICA200 Hardware Vertex Shader
.fvec projection[4], modelView[4]
.fvec lightDir, materialTint

.constf myconst(0.0, 1.0, 0.72, 0.28)
.constf vclrBoost(0.55, 0.45, 0.0, 1.0)
.constf byteScale(0.0039215686, 0.0039215686, 0.0039215686, 0.0039215686)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  amb   myconst.zzzz
.alias  diff  myconst.wwww
.alias  vFloor vclrBoost.xxxx
.alias  vScale vclrBoost.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2
.alias innrm v3

.proc main
    ; Force the w component of inpos to be 1.0
    mov r0.xyz, inpos.xyz
    mov r0.w,   ones

    ; r1 = modelView * inpos
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    ; outpos = projection * r1
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; outtc0 = intex
    mov outtc0, intex

    ; Rotate normal by modelView upper 3x3
    dp3 r2.x, modelView[0], innrm
    dp3 r2.y, modelView[1], innrm
    dp3 r2.z, modelView[2], innrm

    ; Simple directional + ambient lighting: N dot L
    dp3 r3.x, lightDir, r2
    max r3.x, zeros, r3.x
    mul r3.x, diff, r3.x
    add r3.x, amb, r3.x
    min r3.x, ones, r3.x

    ; Normalize u8 vertex color (0..255 -> 0..1), lift dark baked NIF AO, and combine with materialTint * lighting
    mul r5, byteScale, inclr
    mul r5.xyz, vScale, r5.xyz
    add r5.xyz, vFloor, r5.xyz
    mul r4, materialTint, r5
    mul outclr.xyz, r4.xyz, r3.xxx
    mov outclr.w, r4.w

    end
.end
